# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# The port `npm run dev` serves the API on. Docker compose publishes the stack
# on 4002 and 3002 instead, so both can run at once; those are fixed in
# docker-compose.yml and this value does not reach the container.
API_PORT=4000

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=devos
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=devos
POSTGRES_PORT=5432
# Host connection string (docker compose overrides this to the `postgres` service)
DATABASE_URL=postgresql://devos:change-me-locally@localhost:5432/devos?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-differently
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
# Set true when serving over HTTPS
COOKIE_SECURE=false
# Allow account creation. Turn off after you have created your own account.
ALLOW_REGISTRATION=true

# ─── Vault ────────────────────────────────────────────────────────────────────
# Server-side envelope key for vault ciphertext at rest (32 bytes, base64url).
# Losing this makes every stored secret unrecoverable. Back it up separately
# from the database backup.
VAULT_ENVELOPE_KEY=replace-me
VAULT_AUTOLOCK_MINUTES=15
VAULT_CLIPBOARD_SECONDS=20

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The browser only ever talks to the web app, which proxies to the API from the
# server side — so this is the last line of defence, not the wiring.
WEB_ORIGIN=http://localhost:3000

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_MB=50

# ─── AI (Phase 6 — optional, app runs fully without it) ───────────────────────
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Search embeddings. `local` needs no account and runs offline — it matches on
# words rather than on meaning. `openai` gives semantic matching; switching
# provider requires a full re-index, from Settings › Intelligence.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# ─── Notifications by email (Phase 7 — optional, in-app always works) ─────────
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Developer OS <developer-os@localhost>

# ─── Background jobs (Phase 7) ───────────────────────────────────────────────
# Set only in the worker process — `npm run start:worker` sets it for you.
WORKER=false
JOBS_TIMEZONE=UTC
JOBS_DAILY_HOUR=7

# ─── Backups (Phase 7) ───────────────────────────────────────────────────────
BACKUP_PATH=./backups
BACKUP_KEEP=7
BACKUP_EVERY_DAYS=1

# ─── Local AI (Ollama) ────────────────────────────────────────────────────────
# The Developer Intelligence console talks to Ollama and nothing else.
#
# Deliberately left unset. `npm run dev` then falls back to localhost:11434 and
# compose falls back to host.docker.internal:11434, each of which is right for
# where it runs — setting it here would force one answer on both, and inside a
# container `localhost` is the container. Set it only for an Ollama on another
# machine, where the same address is right from everywhere.
# OLLAMA_BASE_URL=http://192.168.1.20:11434
# Left empty on purpose: models are discovered from the server, and naming one
# here would be a guess about what you have pulled. Set it to pick a default.
OLLAMA_CHAT_MODEL=
# `ollama pull nomic-embed-text` before switching EMBEDDING_PROVIDER=ollama.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# A cold model is read off disk before the first token, which is slow once.
OLLAMA_TIMEOUT_MS=120000
