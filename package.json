{
  "name": "personal-developer-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @devos/api",
    "dev:web": "npm run dev -w @devos/web",
    "build": "npm run build -w @devos/api && npm run build -w @devos/web",
    "lint": "npm run lint -w @devos/api && npm run lint -w @devos/web",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx,css}\" \"*.{json,md,yml}\"",
    "worker": "npm run worker -w @devos/api",
    "test": "npm run test -w @devos/api",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @devos/api",
    "db:migrate": "npm run db:migrate -w @devos/api",
    "db:push": "npm run db:push -w @devos/api",
    "db:seed": "npm run db:seed -w @devos/api",
    "auth:reset-password": "npm run auth:reset-password -w @devos/api --",
    "db:studio": "npm run db:studio -w @devos/api",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
